# Smart Classroom Management System - Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/classroom_management_db
REDIS_URL=redis://localhost:6379/0

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# AWS Configuration (for production deployment)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=smart-classroom-storage

# Face Recognition Configuration
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_MODEL=hog
MAX_FACE_ENCODINGS_PER_STUDENT=5

# ML Model Configuration
ML_MODEL_RETRAIN_INTERVAL=86400  # 24 hours in seconds
PREDICTION_CONFIDENCE_THRESHOLD=0.8
CLASSROOM_USAGE_HISTORY_DAYS=30

# Chatbot Configuration
CHATBOT_CONFIDENCE_THRESHOLD=0.3
CHATBOT_MAX_RESPONSE_LENGTH=500
CHATBOT_SESSION_TIMEOUT=1800  # 30 minutes

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Monitoring Configuration
ENABLE_MONITORING=True
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# Security Configuration
BCRYPT_LOG_ROUNDS=12
SESSION_TIMEOUT=3600  # 1 hour
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900  # 15 minutes

# Performance Configuration
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=20
SQLALCHEMY_POOL_RECYCLE=3600
REDIS_CACHE_TIMEOUT=300  # 5 minutes

# Development Configuration
TESTING=False
WTF_CSRF_ENABLED=True
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ECHO=False